# Public configuration. Nothing secret belongs here: every NEXT_PUBLIC_* value is
# shipped to the browser. WITNESS has no server-side key, no backend and no
# database; the wallet signs and the contract decides.

NEXT_PUBLIC_GENLAYER_NETWORK=studionet
NEXT_PUBLIC_GENLAYER_CHAIN=61999

# Optional. Defaults to StudioNet's RPC.
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api

# The deployment of record (docs/deployment.json), byte-verified with scripts/verify_deployment.py.
NEXT_PUBLIC_WITNESS_CONTRACT=0x60191e5A0Cb612d62241EE281cd0fcEEB69c2811

# ── contract tests and scripts (not used by the app) ─────────────────────────
# Set to 0 to run tests/integration against GenLayer StudioNet.
SKIP_INTEGRATION=1
# Reuse a deployment in the live suite instead of deploying the working tree.
WITNESS_CONTRACT=
# genvm-lint picks the newest cached GenVM bundle; this runner lives in v0.3.0-rc7.
GENVM_VERSION=v0.3.0-rc7
